{
	"name": "df_silver_sprint_results",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_sprint_results_sql",
						"type": "DatasetReference"
					},
					"name": "bronzeSprint"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_races_sql",
						"type": "DatasetReference"
					},
					"name": "claveRaces"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_drivers_sql",
						"type": "DatasetReference"
					},
					"name": "claveDrivers"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_constructors_sql",
						"type": "DatasetReference"
					},
					"name": "claveConstructors"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_status_sql",
						"type": "DatasetReference"
					},
					"name": "claveStatus"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_sprint_results_sql",
						"type": "DatasetReference"
					},
					"name": "silverSprint"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_quarantine_results_sql",
						"type": "DatasetReference"
					},
					"name": "cuarentena"
				}
			],
			"transformations": [
				{
					"name": "seleccionarCarrera"
				},
				{
					"name": "seleccionarPiloto"
				},
				{
					"name": "seleccionarConstructor"
				},
				{
					"name": "seleccionarEstado"
				},
				{
					"name": "limpiarTodo"
				},
				{
					"name": "convertirTipos"
				},
				{
					"name": "convertirTiempos"
				},
				{
					"name": "buscarCarrera"
				},
				{
					"name": "buscarPiloto"
				},
				{
					"name": "buscarConstructor"
				},
				{
					"name": "buscarEstado"
				},
				{
					"name": "evaluarRechazo"
				},
				{
					"name": "dividirRechazos"
				},
				{
					"name": "quitarDuplicados"
				},
				{
					"name": "soloValidos"
				},
				{
					"name": "prepararCuarentena"
				}
			],
			"scriptLines": [
				"source(output(",
				"          resultId as string,",
				"          raceId as string,",
				"          driverId as string,",
				"          constructorId as string,",
				"          number as string,",
				"          grid as string,",
				"          position as string,",
				"          positionText as string,",
				"          positionOrder as string,",
				"          points as string,",
				"          laps as string,",
				"          time as string,",
				"          milliseconds as string,",
				"          fastestLap as string,",
				"          fastestLapTime as string,",
				"          statusId as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronzeSprint",
				"source(output(",
				"          race_id as integer,",
				"          season_year as integer,",
				"          round_number as integer,",
				"          circuit_id as integer,",
				"          race_name as string,",
				"          race_date as date,",
				"          race_time_utc as string,",
				"          sprint_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> claveRaces",
				"source(output(",
				"          driver_id as integer,",
				"          driver_ref as string,",
				"          permanent_number as integer,",
				"          driver_code as string,",
				"          forename as string,",
				"          surname as string,",
				"          dob as date,",
				"          nationality as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> claveDrivers",
				"source(output(",
				"          constructor_id as integer,",
				"          constructor_ref as string,",
				"          constructor_name as string,",
				"          nationality as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> claveConstructors",
				"source(output(",
				"          status_id as integer,",
				"          status_description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> claveStatus",
				"claveRaces select(mapColumn(",
				"          chk_race = race_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> seleccionarCarrera",
				"claveDrivers select(mapColumn(",
				"          chk_driver = driver_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> seleccionarPiloto",
				"claveConstructors select(mapColumn(",
				"          chk_constructor = constructor_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> seleccionarConstructor",
				"claveStatus select(mapColumn(",
				"          chk_status = status_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> seleccionarEstado",
				"bronzeSprint derive(resultId = iif(isNull(resultId) || trim(resultId) == '' || upper(trim(resultId)) == 'NULL' || upper(trim(resultId)) == 'N/A' || trim(resultId) == '\\\\N', toString(null()), trim(resultId)),",
				"          raceId = iif(isNull(raceId) || trim(raceId) == '' || upper(trim(raceId)) == 'NULL' || upper(trim(raceId)) == 'N/A' || trim(raceId) == '\\\\N', toString(null()), trim(raceId)),",
				"          driverId = iif(isNull(driverId) || trim(driverId) == '' || upper(trim(driverId)) == 'NULL' || upper(trim(driverId)) == 'N/A' || trim(driverId) == '\\\\N', toString(null()), trim(driverId)),",
				"          constructorId = iif(isNull(constructorId) || trim(constructorId) == '' || upper(trim(constructorId)) == 'NULL' || upper(trim(constructorId)) == 'N/A' || trim(constructorId) == '\\\\N', toString(null()), trim(constructorId)),",
				"          number = iif(isNull(number) || trim(number) == '' || upper(trim(number)) == 'NULL' || upper(trim(number)) == 'N/A' || trim(number) == '\\\\N', toString(null()), trim(number)),",
				"          grid = iif(isNull(grid) || trim(grid) == '' || upper(trim(grid)) == 'NULL' || upper(trim(grid)) == 'N/A' || trim(grid) == '\\\\N', toString(null()), trim(grid)),",
				"          position = iif(isNull(position) || trim(position) == '' || upper(trim(position)) == 'NULL' || upper(trim(position)) == 'N/A' || trim(position) == '\\\\N', toString(null()), trim(position)),",
				"          positionOrder = iif(isNull(positionOrder) || trim(positionOrder) == '' || upper(trim(positionOrder)) == 'NULL' || upper(trim(positionOrder)) == 'N/A' || trim(positionOrder) == '\\\\N', toString(null()), trim(positionOrder)),",
				"          points = iif(isNull(points) || trim(points) == '' || upper(trim(points)) == 'NULL' || upper(trim(points)) == 'N/A' || trim(points) == '\\\\N', toString(null()), trim(points)),",
				"          laps = iif(isNull(laps) || trim(laps) == '' || upper(trim(laps)) == 'NULL' || upper(trim(laps)) == 'N/A' || trim(laps) == '\\\\N', toString(null()), trim(laps)),",
				"          milliseconds = iif(isNull(milliseconds) || trim(milliseconds) == '' || upper(trim(milliseconds)) == 'NULL' || upper(trim(milliseconds)) == 'N/A' || trim(milliseconds) == '\\\\N', toString(null()), trim(milliseconds)),",
				"          fastestLap = iif(isNull(fastestLap) || trim(fastestLap) == '' || upper(trim(fastestLap)) == 'NULL' || upper(trim(fastestLap)) == 'N/A' || trim(fastestLap) == '\\\\N', toString(null()), trim(fastestLap)),",
				"          fastestLapTime = iif(isNull(fastestLapTime) || trim(fastestLapTime) == '' || upper(trim(fastestLapTime)) == 'NULL' || upper(trim(fastestLapTime)) == 'N/A' || trim(fastestLapTime) == '\\\\N', toString(null()), trim(fastestLapTime)),",
				"          statusId = iif(isNull(statusId) || trim(statusId) == '' || upper(trim(statusId)) == 'NULL' || upper(trim(statusId)) == 'N/A' || trim(statusId) == '\\\\N', toString(null()), trim(statusId))) ~> limpiarTodo",
				"limpiarTodo derive(sprint_result_id = toInteger(resultId),",
				"          race_id = toInteger(raceId),",
				"          driver_id = toInteger(driverId),",
				"          constructor_id = toInteger(constructorId),",
				"          status_id = toInteger(statusId),",
				"          car_number = toInteger(number),",
				"          grid_position = toInteger(grid),",
				"          final_position = toInteger(position),",
				"          position_order = toInteger(positionOrder),",
				"          points_num = toDecimal(points, 6, 2),",
				"          laps_completed = toInteger(laps),",
				"          sprint_time_ms = toLong(milliseconds),",
				"          fastest_lap_number = toInteger(fastestLap)) ~> convertirTipos",
				"convertirTipos derive(fastest_lap_ms = iif(regexMatch(fastestLapTime, '^[0-9]{1,2}:[0-9]{2}[.][0-9]{3}$'), toInteger(regexReplace(fastestLapTime, '[:].*$', '')) * 60000 + toInteger(regexReplace(regexReplace(fastestLapTime, '^[0-9]+[:]', ''), '[.].*$', '')) * 1000 + toInteger(regexReplace(fastestLapTime, '^.*[.]', '')), toInteger(null()))) ~> convertirTiempos",
				"convertirTiempos, seleccionarCarrera lookup(race_id == chk_race,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> buscarCarrera",
				"buscarCarrera, seleccionarPiloto lookup(driver_id == chk_driver,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> buscarPiloto",
				"buscarPiloto, seleccionarConstructor lookup(constructor_id == chk_constructor,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> buscarConstructor",
				"buscarConstructor, seleccionarEstado lookup(status_id == chk_status,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> buscarEstado",
				"buscarEstado derive(motivo = case(isNull(sprint_result_id) || isNull(race_id) || isNull(driver_id) || isNull(constructor_id) || isNull(status_id) || isNull(grid_position) || isNull(position_order) || isNull(points_num) || isNull(laps_completed), 'Formato inválido o campo obligatorio vacío', isNull(chk_race), 'Llave foránea inexistente: race_id', isNull(chk_driver), 'Llave foránea inexistente: driver_id', isNull(chk_constructor), 'Llave foránea inexistente: constructor_id', isNull(chk_status), 'Llave foránea inexistente: status_id', startsWith(points, '-'), 'Puntos negativos (CHECK points >= 0)', 'OK')) ~> evaluarRechazo",
				"evaluarRechazo split(motivo != 'OK',",
				"     disjoint: false) ~> dividirRechazos@(rechazados, validos)",
				"dividirRechazos@validos window(over(sprint_result_id),",
				"     asc(sprint_result_id, true),",
				"     NumFila = rowNumber()) ~> quitarDuplicados",
				"quitarDuplicados filter(NumFila == 1) ~> soloValidos",
				"dividirRechazos@rechazados derive(raw_result_id = resultId,",
				"          raw_race_id = raceId,",
				"          raw_driver_id = driverId,",
				"          raw_constructor_id = constructorId,",
				"          raw_points = points,",
				"          quarantine_reason = motivo,",
				"          {_source_file} = 'sprint_results.csv') ~> prepararCuarentena",
				"soloValidos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          sprint_result_id as integer,",
				"          race_id as integer,",
				"          driver_id as integer,",
				"          constructor_id as integer,",
				"          status_id as integer,",
				"          car_number as integer,",
				"          grid_position as integer,",
				"          final_position as integer,",
				"          position_order as integer,",
				"          points as decimal(6,2),",
				"          laps_completed as integer,",
				"          sprint_time_ms as long,",
				"          fastest_lap_number as integer,",
				"          fastest_lap_ms as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sprint_result_id,",
				"          race_id,",
				"          driver_id,",
				"          constructor_id,",
				"          status_id,",
				"          car_number,",
				"          grid_position,",
				"          final_position,",
				"          position_order,",
				"          points = points_num,",
				"          laps_completed,",
				"          sprint_time_ms,",
				"          fastest_lap_number,",
				"          fastest_lap_ms",
				"     )) ~> silverSprint",
				"prepararCuarentena sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          quarantine_id as long,",
				"          raw_result_id as string,",
				"          raw_race_id as string,",
				"          raw_driver_id as string,",
				"          raw_constructor_id as string,",
				"          raw_points as string,",
				"          quarantine_reason as string,",
				"          {_source_file} as string,",
				"          {_rejected_at} as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          raw_result_id,",
				"          raw_race_id,",
				"          raw_driver_id,",
				"          raw_constructor_id,",
				"          raw_points,",
				"          quarantine_reason,",
				"          {_source_file}",
				"     )) ~> cuarentena"
			]
		}
	}
}