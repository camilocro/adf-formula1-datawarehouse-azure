{
	"name": "df_bronze_pit_stops",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_pit_stops_csv",
						"type": "DatasetReference"
					},
					"name": "bronzePitStops"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_pit_stops_sql",
						"type": "DatasetReference"
					},
					"name": "sinkBronzePitStops"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          raceId as string,",
				"          driverId as string,",
				"          stop as string,",
				"          lap as string,",
				"          time as string,",
				"          duration as string,",
				"          milliseconds as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> bronzePitStops",
				"bronzePitStops sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          raceId as string,",
				"          driverId as string,",
				"          stop as string,",
				"          lap as string,",
				"          time as string,",
				"          duration as string,",
				"          milliseconds as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          raceId,",
				"          driverId,",
				"          stop,",
				"          lap,",
				"          time,",
				"          duration,",
				"          milliseconds",
				"     )) ~> sinkBronzePitStops"
			]
		}
	}
}