{
	"name": "df_bronze_status",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_status_csv",
						"type": "DatasetReference"
					},
					"name": "bronzeStatus"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_status_sql",
						"type": "DatasetReference"
					},
					"name": "sinkBronzeStatus"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          statusId as short,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> bronzeStatus",
				"bronzeStatus sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          statusId as string,",
				"          status as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkBronzeStatus"
			]
		}
	}
}