		{
			"name": "[concat(parameters('factoryName'), '/df_bronze_circuits')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "bronze"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "bronze_circuits_csv",
								"type": "DatasetReference"
							},
							"name": "bronzeCircuits"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_bronze_circuits_sql",
								"type": "DatasetReference"
							},
							"name": "sinkBronzeCircuits"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          circuitId as string,",
						"          circuitRef as string,",
						"          name as string,",
						"          location as string,",
						"          country as string,",
						"          lat as string,",
						"          lng as string,",
						"          alt as string,",
						"          url as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> bronzeCircuits",
						"bronzeCircuits sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          circuitId as string,",
						"          circuitRef as string,",
						"          name as string,",
						"          location as string,",
						"          country as string,",
						"          lat as string,",
						"          lng as string,",
						"          alt as string,",
						"          url as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          circuitId,",
						"          circuitRef,",
						"          name,",
						"          location,",
						"          country,",
						"          lat,",
						"          lng,",
						"          alt,",
						"          url",
						"     )) ~> sinkBronzeCircuits"
					]
				}
			},
			"dependsOn": []
		},
