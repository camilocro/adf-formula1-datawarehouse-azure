				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('sql_dw_formula1_properties_typeProperties_server')]",
					"database": "[parameters('sql_dw_formula1_properties_typeProperties_database')]",
					"encrypt": "mandatory",
