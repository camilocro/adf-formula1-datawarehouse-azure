		"sa_formula1_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"sa_formula1\""
		},
		"sql_dw_formula1_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql_dw_formula1\""
		},
		"sa_formula1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbf165743264.dfs.core.windows.net/"
		},
		"sql_dw_formula1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-f1-65743264.database.windows.net"
		},
		"sql_dw_formula1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_formula_1"
		},
		"sql_dw_formula1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "camilo"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
