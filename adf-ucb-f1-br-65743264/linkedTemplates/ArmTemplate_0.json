				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('sa_formula1_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('sa_formula1_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
